[Unit]
Description=SolaXd, the daemon for communication with SolaX-X1_Mini inverter via RS485
After=network-online.target

[Service]
Restart=always
RestartSec=60
# Every exit is restarted, 78 (EX_CONFIG) included: a configuration error is fixed outside solaxd
# (its options or the broker) and the next start picks the fix up
EnvironmentFile=-/etc/default/solaxd
ExecStart=/usr/bin/solaxd $SOLAXD_OPTS

[Install]
WantedBy=multi-user.target
